
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f4f8ff;
    color: #26354a;
}

header {
    background: #ffffff;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 10px #00000010;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: #2563eb;
}

nav a {
    text-decoration: none;
    color: #26354a;
    margin-left: 22px;
    font-weight: bold;
}

nav a:hover {
    color: #2563eb;
}

.hero {
    padding: 90px 10%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(120deg, #dbeafe, #eff6ff);
    gap: 30px;
}

.hero-content {
    max-width: 600px;
}

.subtitle {
    color: #2563eb;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: 45px;
    margin-bottom: 20px;
    line-height: 1.2;
}

.hero-content > p:not(.subtitle) {
    line-height: 1.7;
    margin-bottom: 25px;
}

.hero-icon {
    font-size: 130px;
}

.btn {
    display: inline-block;
    background: #2563eb;
    color: white;
    padding: 14px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
}

.btn:hover {
    background: #1d4ed8;
}

.dashboard, .jadwal, .tips {
    padding: 65px 8%;
    text-align: center;
}

.dashboard h2, .jadwal h2, .tips h2 {
    margin-bottom: 12px;
    color: #1e40af;
}

.tanggal {
    margin: 15px 0 25px;
    color: #64748b;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 25px;
}

.card {
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 4px 15px #0000000d;
}

.card span {
    font-size: 35px;
}

.card h3 {
    font-size: 30px;
    color: #2563eb;
    margin: 12px 0;
}

.jadwal {
    background: #eaf2ff;
}

form {
    background: white;
    padding: 25px;
    border-radius: 12px;
    margin: 30px auto;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    max-width: 900px;
}

input, select {
    padding: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    flex: 1;
    min-width: 150px;
}

button {
    padding: 13px 18px;
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #1d4ed8;
}

.progress-box {
    background: white;
    padding: 20px;
    border-radius: 12px;
    max-width: 900px;
    margin: 25px auto;
}

.progress-bg {
    height: 13px;
    background: #dbeafe;
    border-radius: 20px;
    margin: 15px 0;
    overflow: hidden;
}

#progressBar {
    width: 0%;
    height: 100%;
    background: #2563eb;
    transition: width 0.4s;
}

.kegiatan {
    background: white;
    padding: 18px;
    margin: 12px auto;
    max-width: 900px;
    border-radius: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    text-align: left;
    box-shadow: 0 3px 10px #00000008;
}

.kegiatan.done {
    opacity: 0.6;
}

.kegiatan.done .nama {
    text-decoration: line-through;
}

.info {
    flex: 1;
}

.info p {
    margin-top: 7px;
    color: #64748b;
    font-size: 14px;
}

.hapus {
    background: #ef4444;
}

.hapus:hover {
    background: #dc2626;
}

.tips-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 30px;
}

.tip {
    background: white;
    padding: 25px;
    border-radius: 12px;
    text-align: left;
    box-shadow: 0 3px 12px #0000000d;
}

.tip h3 {
    color: #2563eb;
    margin-bottom: 10px;
}

.tip p {
    line-height: 1.6;
}

footer {
    background: #1e3a8a;
    color: white;
    padding: 35px;
    text-align: center;
    line-height: 2;
}

@media (max-width: 650px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        margin: 0 7px;
        font-size: 13px;
    }

    .hero {
        padding: 55px 7%;
        flex-direction: column;
        text-align: center;
    }

    .hero h1 {
        font-size: 32px;
    }

    .hero-icon {
        font-size: 90px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .tips-container {
        grid-template-columns: 1fr;
    }

    .kegiatan {
        flex-wrap: wrap;
    }

    form {
        flex-direction: column;
    }

    input, select, form button {
        width: 100%;
    }
}
